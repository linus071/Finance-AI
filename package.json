{
  "name": "finance-mcp",
  "version": "0.1.0",
  "description": "Local-first MCP server for your bank statements. Your transactions stay in a SQLite file on your machine.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "finance-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke-mcp.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
